{
  "name": "Veritaz / ConnectWise",
  "fields": [
    { "key": "client", "label": "Client", "on": "task", "type": "list", "list": "clients", "input": "search", "groupBy": true },
    { "key": "ticket", "label": "Ticket #", "on": "task", "type": "text", "prefix": "#" },
    { "key": "workType", "label": "Work Type", "on": "session", "type": "list", "list": "workTypes" },
    { "key": "billing", "label": "Billing", "on": "session", "type": "choice", "options": ["Billable", "Do Not Bill", "No Charge"], "input": "segmented", "short": ["B", "NB", "NC"] },
    { "key": "noteTo", "label": "Notes to", "on": "session", "type": "choice", "options": ["Internal", "Discussion"], "input": "segmented", "default": "Internal" }
  ],
  "lists": {
    "workTypes": [
      { "name": "Remote - Business Hours", "defaults": { "billing": "Billable" } },
      { "name": "Onsite - Business Hours", "defaults": { "billing": "Billable" } },
      { "name": "In-house - Business Hours", "defaults": { "billing": "Billable" } },
      { "name": "Office", "defaults": { "billing": "Do Not Bill" } },
      { "name": "Internal Meeting", "defaults": { "billing": "Do Not Bill" } },
      { "name": "Internal Technical", "defaults": { "billing": "Do Not Bill" } },
      { "name": "Communications", "defaults": { "billing": "Do Not Bill" } },
      { "name": "Project Coordination", "defaults": { "billing": "Do Not Bill" } },
      { "name": "SALES - Quoting", "defaults": { "billing": "Do Not Bill" } },
      { "name": "Travel - To Client", "defaults": { "billing": "Do Not Bill" } },
      { "name": "Travel - From Client", "defaults": { "billing": "Do Not Bill" } },
      { "name": "Training - Providing", "defaults": { "billing": "Do Not Bill" } }
    ]
  },
  "entryFormat": {
    "target": "ConnectWise",
    "date": "MM/DD/YYYY",
    "time": "h:mm A",
    "hours": "decimal",
    "fields": ["ticket", "client", "date", "start", "end", "hours", "workType", "billing", "noteTo", "notes"]
  },
  "connectwise": { "ticketField": "ticket", "clientField": "client", "workTypeField": "workType", "billingField": "billing", "noteToField": "noteTo" }
}
