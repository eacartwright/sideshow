# Copy this file to ".env" and fill in your values. Never commit the real .env.

# Your ConnectWise cloud region host, e.g. api-na.myconnectwise.net (US),
# api-eu.myconnectwise.net (EU), api-aus.myconnectwise.net (AUS),
# or your own domain if self-hosted.
CW_SITE=

# Your ConnectWise Company ID (the short code you use to log in)
CW_COMPANY_ID=

# The public/private keypair from your API Member's API Keys tab
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=

# A GUID you register at developer.connectwise.com (free, one-time)
CW_CLIENT_ID=

# Your CW member identifier (the username you log in with). Time entries are pushed as this
# member. Leave empty to turn pushing off (ticket lookup still works).
CW_MEMBER=

# Leave all CW_* empty to run without ConnectWise (ticket lookup is hidden).

# Job fields (client, ticket #, work type...): a file in packages/server/profiles, without .json.
# Leave empty for a plain task and time tracker.
PROFILE=veritaz-cw
